# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env — ele está no .gitignore.

# ── Supabase (cliente — prefixo VITE_ é exposto no bundle) ──────
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PROJECT_ID=SEU_PROJETO_ID

# ── Supabase (server-side — NUNCA usar prefixo VITE_) ───────────
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Chave de serviço — bypassa RLS. Apenas em ServerFn, nunca no cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Secrets de compartilhamento ──────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARE_JWT_SECRET=gere-um-secret-de-64-hex-chars-aqui
# Secret para HMAC dos OTPs de 6 dígitos (evita rainbow table)
OTP_HMAC_SECRET=gere-outro-secret-de-64-hex-chars-aqui

# ── Email (Resend via Lovable) ───────────────────────────────────
RESEND_API_KEY=re_...
LOVABLE_API_KEY=...

# ── Rate limiting distribuído (Upstash Redis — produção) ─────────
# Sem isso, o rate limit é in-memory por instância serverless.
# Criar em: console.upstash.com
UPSTASH_REDIS_REST_URL=https://SEU_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# ── Vercel (apenas para uso local com CLI) ───────────────────────
# Não necessário em produção — o Vercel injeta automaticamente.
# VERCEL_TOKEN=...
